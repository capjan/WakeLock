<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Capjan.WakeLock.Tool</RootNamespace>
    <AssemblyName>Capjan.WakeLock.Tool</AssemblyName>
    <PackageId>Capjan.WakeLock.Tool</PackageId>
    <Authors>Jan Ruhländer</Authors>
    <Description>Command line tool that keeps the machine awake until a key is pressed.</Description>
    <PackageTags>wakelock;dotnet-tool;cli;sleep;power-management</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wakelock</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capjan.WakeLock.Abstractions/Capjan.WakeLock.Abstractions.csproj" />
    <ProjectReference Include="../../src/Capjan.WakeLock.Windows/Capjan.WakeLock.Windows.csproj" />
    <ProjectReference Include="../../src/Capjan.WakeLock.MacOS/Capjan.WakeLock.MacOS.csproj" />
    <ProjectReference Include="../../src/Capjan.WakeLock.Linux/Capjan.WakeLock.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/Capjan.WakeLock.Abstractions/icon.png" Link="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
