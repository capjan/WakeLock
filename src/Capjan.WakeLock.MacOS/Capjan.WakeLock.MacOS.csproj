<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Capjan.WakeLock</RootNamespace>
    <AssemblyName>Capjan.WakeLock.MacOS</AssemblyName>
    <PackageId>Capjan.WakeLock.MacOS</PackageId>
    <Authors>Work</Authors>
    <Description>macOS wake lock implementation for preventing system sleep or display sleep.</Description>
    <PackageTags>wakelock;sleep;display;power-management;macos</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capjan.WakeLock.Abstractions\Capjan.WakeLock.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Capjan.WakeLock.Abstractions\icon.png" Link="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
